# WorksAI Live Interpreter v1.3.0 — Placeholder Environment Template (Zero Secrets)
WORKSAI_ENV=development
HOSTINGER_AI_ROUTER_BASE_URL=https://router.hostinger.com/v1
HOSTINGER_GPT_MODEL=gpt-5-mini
HOSTINGER_GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_COHERE_KEY_FAILOVER=false

# Provision secrets via `npm run setup:keys` or `npx wrangler secret put <NAME> --name worksai-live-interpreter`
HOSTINGER_AI_ROUTER_API_KEY=your_hostinger_router_key_starting_with_sk_hstgr
COHERE_API_KEY=your_cohere_api_key
OPENAI_API_KEY=your_direct_openai_realtime_key
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
JWT_SECRET=your_32_byte_hmac_sha256_session_signing_secret
WORKSAI_BOOTSTRAP_SECRET=your_32_byte_one_time_bootstrap_secret
BYOK_ENCRYPTION_KEY=your_separate_32_byte_aes_256_gcm_byok_encryption_key
